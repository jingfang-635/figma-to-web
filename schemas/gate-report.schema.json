{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figma-web.local/schemas/gate-report.schema.json",
  "title": "GateReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runStamp", "overall", "legs", "runtime"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runStamp": { "type": "string", "minLength": 1 },
    "overall": { "enum": ["PASS", "FAIL"] },
    "legs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pixel", "geom", "text", "data"],
      "properties": {
        "pixel": { "$ref": "#/$defs/leg" },
        "geom": { "$ref": "#/$defs/leg" },
        "text": { "$ref": "#/$defs/leg" },
        "data": { "$ref": "#/$defs/leg" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["webOk", "apiOk"],
      "properties": {
        "webOk": { "type": "boolean" },
        "apiOk": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "screenId": { "type": "string" },
        "path": { "type": "string" },
        "message": { "type": "string" },
        "evidence": { "type": "string" }
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failures"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "failures": {
          "type": "array",
          "items": { "$ref": "#/$defs/failure" }
        }
      }
    }
  }
}
