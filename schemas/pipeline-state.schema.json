{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figma-web.local/schemas/pipeline-state.schema.json",
  "title": "PipelineState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "round",
    "maxRounds",
    "blocked",
    "history",
    "completed",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "phase": {
      "enum": [
        "DECISION",
        "INGEST",
        "SPEC",
        "IR",
        "CODEGEN",
        "FIDELITY",
        "GATE",
        "REPAIR",
        "DONE",
        "STOPPED"
      ]
    },
    "round": { "type": "integer", "minimum": 0 },
    "maxRounds": { "type": "integer", "minimum": 1 },
    "blocked": { "type": "boolean" },
    "blockReason": { "type": ["string", "null"] },
    "lastError": { "type": ["string", "null"] },
    "history": { "type": "array" },
    "skipLegs": {
      "type": "array",
      "items": { "enum": ["pixel", "geom", "text", "icons", "cells", "layout", "data", "impl"] }
    },
    "skipScreenIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gateLegs": {
      "type": "array",
      "description": "Leg roster frozen by the Orchestrator when FIDELITY starts. A screen written before a leg existed is not asserted by that leg, so the roster must be complete before any screen is written.",
      "items": { "enum": ["pixel", "geom", "text", "icons", "cells", "layout", "data", "impl"] }
    },
    "legsAddedAfterFidelity": {
      "type": "array",
      "description": "Legs introduced after FIDELITY began. Each entry means the already-written screens were produced without that leg in force, so they must be re-processed (and the list emptied) before GATE can be trusted.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["leg", "addedAt", "screensReprocessed"],
        "properties": {
          "leg": { "enum": ["pixel", "geom", "text", "icons", "cells", "layout", "data", "impl"] },
          "addedAt": { "type": "string" },
          "screensReprocessed": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DECISION",
        "INGEST",
        "SPEC",
        "IR",
        "CODEGEN",
        "FIDELITY",
        "GATE",
        "DONE"
      ],
      "properties": {
        "DECISION": { "type": "boolean" },
        "INGEST": { "type": "boolean" },
        "SPEC": { "type": "boolean" },
        "IR": { "type": "boolean" },
        "CODEGEN": { "type": "boolean" },
        "FIDELITY": { "type": "boolean" },
        "GATE": { "type": "boolean" },
        "DONE": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "appSpec",
        "frameManifest",
        "layoutIrDir",
        "visualIr",
        "gateReport"
      ],
      "properties": {
        "decision": { "type": "string" },
        "appSpec": { "type": "string" },
        "frameManifest": { "type": "string" },
        "layoutIrDir": { "type": "string" },
        "visualIr": { "type": "string" },
        "gateReport": { "type": ["string", "null"] }
      }
    }
  }
}
