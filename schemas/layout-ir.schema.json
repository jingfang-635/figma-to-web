{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figma-web.local/schemas/layout-ir.schema.json",
  "title": "LayoutIR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "screenId",
    "frameId",
    "bounds",
    "tree",
    "texts",
    "icons"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "screenId": { "type": "string", "minLength": 1 },
    "frameId": { "type": "string", "minLength": 1 },
    "bounds": { "$ref": "#/$defs/bounds" },
    "tree": { "type": "object" },
    "texts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "characters", "bounds"],
        "properties": {
          "nodeId": { "type": "string" },
          "characters": { "type": "string" },
          "style": { "type": "object" },
          "bounds": { "type": "object" }
        }
      }
    },
    "icons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "exportable", "bounds", "symbol"],
        "properties": {
          "nodeId": { "type": "string" },
          "exportable": { "type": "boolean" },
          "bounds": { "$ref": "#/$defs/bounds" },
          "color": { "type": "string" },
          "fills": {
            "type": "array",
            "items": { "$ref": "#/$defs/paint" },
            "description": "Optional: the paint(s) that draw the glyph, when the node carries one."
          },
          "symbol": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "role"],
            "properties": {
              "source": {
                "enum": ["figma-name", "glyph-match", "unresolved"],
                "description": "figma-name: node name is a usable symbol; glyph-match: recovered by matching the drawn glyph against the reference screenshot; unresolved: no symbol recovered (rendering gate will report the empty slot)."
              },
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "source": { "enum": ["figma-name", "glyph-match"] } },
                  "required": ["source"]
                },
                "then": { "required": ["name"] }
              }
            ]
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "description": "Grid/chrome boxes the prototype draws as plain rectangles: calendar cells, their header band, legend swatches, a today badge. They are neither controls (the geom leg pairs only input-like roles at runtime) nor icons, so without this list a calendar whose header band is 3x too tall and whose cells all render flat white is invisible to every leg.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "role", "bounds"],
        "properties": {
          "nodeId": { "type": "string" },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "calendar-head | calendar-day | legend-swatch | calendar-today | … (a free-form role the cell leg pairs read in reading order)"
          },
          "bounds": { "$ref": "#/$defs/bounds" },
          "fill": { "type": "string", "description": "Cell background paint, when the prototype draws one." },
          "sample": {
            "type": "boolean",
            "description": "Live content sample — a chip row inside a day cell, a segmented-control pill. Carries paint and metrics for the page to read, but is never asserted by the cell leg, because how many rows there are is a data question."
          },
          "hostNodeId": { "type": "string", "description": "For a sample: the cell or track it is drawn on." },
          "accent": { "type": "string", "description": "For a sample: the paint the prototype gives the sample's own text. This is where the IR records which tint belongs to which legend colour." }
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "role", "bounds"],
        "properties": {
          "nodeId": { "type": "string" },
          "role": { "type": "string" },
          "bounds": { "$ref": "#/$defs/bounds" },
          "fills": {
            "type": "array",
            "items": { "$ref": "#/$defs/paint" },
            "description": "Control background paint. Preserved so the screen renders the IR's colour instead of inventing one."
          },
          "strokes": {
            "type": "array",
            "items": { "$ref": "#/$defs/paint" },
            "description": "Control border paint."
          },
          "cornerRadius": { "type": ["number", "null"] },
          "strokeWeight": { "type": ["number", "null"] }
        }
      }
    }
  },
  "$defs": {
    "paint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "SOLID",
            "GRADIENT_LINEAR",
            "GRADIENT_RADIAL",
            "GRADIENT_ANGULAR",
            "GRADIENT_DIAMOND",
            "IMAGE"
          ]
        },
        "color": { "type": "string" },
        "opacity": { "type": "number" },
        "stops": { "type": "array" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    }
  }
}
