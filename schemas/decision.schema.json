{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figma-web.local/schemas/decision.schema.json",
  "title": "PipelineDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "figma", "stack", "auth", "output", "envCheck"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileKey"],
      "properties": {
        "fileKey": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string" }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "frontend", "backend", "database", "orm", "ui"],
      "properties": {
        "id": { "enum": ["A", "A2", "B", "C", "D"] },
        "language": { "enum": ["node", "java"] },
        "frontend": { "enum": ["react-vite", "vue-vite"] },
        "backend": { "enum": ["nestjs", "express", "spring-boot"] },
        "database": { "enum": ["postgresql", "mysql"] },
        "orm": { "enum": ["prisma", "jpa", "mybatis"] },
        "ui": {
          "enum": ["antd", "mui", "mantine", "element-plus", "ant-design-vue"]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["jwt", "none"] }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "root", "webDir", "apiDir"],
      "properties": {
        "mode": { "enum": ["apps", "output-run"] },
        "root": { "type": "string", "minLength": 1 },
        "webDir": { "type": "string", "minLength": 1 },
        "apiDir": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 }
      }
    },
    "envCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "missingKeys"],
      "properties": {
        "ok": { "type": "boolean" },
        "missingKeys": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
